# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# ── Supabase (required for auth + persistent chat history) ──────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Project ref is the subdomain part of VITE_SUPABASE_URL (e.g. "your-project-ref"
# in https://your-project-ref.supabase.co). Used by the MCP server's OAuth issuer.
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ── OpenRouter (optional — user can also enter their own key in Settings) ─────
# Only needed if you want a server-side proxy for the API key.
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
